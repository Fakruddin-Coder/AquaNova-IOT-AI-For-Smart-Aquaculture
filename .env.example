# =================================================================
# AquaNova — Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# =================================================================

# ----------------- Database & Backend -----------------
MONGODB_URI=mongodb://localhost:27017/aquanova
JWT_SECRET=your_super_secret_jwt_key_change_in_production
PORT=5000
NODE_ENV=development

# ----------------- Frontend Configuration -----------------
VITE_API_URL=/api

# ----------------- MQTT Broker Configuration -----------------
# Browser WebSocket MQTT endpoint (port 9001 in mosquitto.conf)
# ESP32 devices connect via TCP on port 1884 (or standard 1883)
VITE_MQTT_URL=ws://localhost:9001
# For production cloud broker with TLS:
# VITE_MQTT_URL=wss://your-mqtt-broker.example.com:8884

# ----------------- Email Service (Brevo / Sendinblue) -----------------
# Option 1: Brevo REST API v3 Key (Recommended)
# Obtain your API key at: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=your_brevo_api_key_here

# Verified sender email configured in your Brevo account
EMAIL_FROM=notifications@yourdomain.com
EMAIL_FROM_NAME="AquaNova Smart Aquaculture"

# Option 2: SMTP Configuration (Alternative to API key)
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USER=your_smtp_username
# EMAIL_PASSWORD=your_smtp_password

# ----------------- Razorpay Payment Gateway (Optional) -----------------
# Get your test/live keys at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ----------------- System Admin Account -----------------
ADMIN_EMAIL=admin@aquanova.io
